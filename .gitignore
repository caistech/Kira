# Supabase CLI local state (contains pooler/connection info)
supabase/.temp/

# gstack browser daemon state (contains session tokens)
.gstack/

# Naive-tester screenshots — the written reports are committed, the images are not
# (20MB+ per sweep; regenerate by re-running /naive-tester)
naive-tester-reports/**/*.png
naive-tester-reports/**/*.jpg
naive-tester-reports/**/screenshots/

# Collaborator commercial terms — named individuals, proposed splits, unsigned.
# Deliberately local: a private repo is still the wrong place for someone else's
# unagreed compensation, and it only takes one `git add -A` to publish it to
# everyone with clone access.
docs/collaborator-terms/

# Git worktrees another session creates while working on a branch. This is a FULL SECOND CHECKOUT
# of this repo — committing it would nest a copy of the repo inside itself. vitest already excludes
# it from test discovery for the same reason.
.claude/worktrees/

# Fetched Genome artefacts. These are exports of an account's own record — even from a
# synthetic QA account they are the shape of a thing that must never be committed
# (PRODUCT_STANDARDS: data exports are treated as PII).
manual-*.html
